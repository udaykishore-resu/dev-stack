# Per-developer overrides.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Docker Compose merges docker-compose.override.yml on top of
# docker-compose.yml automatically, with no -f flag. It is gitignored, so this
# is where personal changes go instead of edits to the committed file that you
# then have to remember not to commit.
#
# Everything below is commented out. Uncomment what you need.

services:

  # -------------------------------------------------------------------------
  # Live-reload the API against your working tree instead of a built image.
  # Replaces the image's entrypoint with `go run`, so a save-and-restart is
  # seconds rather than a full multi-stage rebuild.
  # -------------------------------------------------------------------------
  # guest-score-api:
  #   image: golang:1.24-alpine
  #   build: !reset null          # `!reset` drops the inherited build block
  #   working_dir: /src
  #   command: ["go", "run", "./cmd/server"]
  #   volumes:
  #     - ../guest-score/backend:/src
  #     - gocache:/root/.cache/go-build
  #   environment:
  #     GS_LOG_LEVEL: debug

  # -------------------------------------------------------------------------
  # Hard resource ceilings. Off by default because `deploy.resources.limits`
  # is silently ignored by `docker compose up` on some engines (it is a Swarm
  # key that Compose v2 honours only on Linux with cgroups v2), and a limit
  # that looks applied but is not is worse than none.
  # Verify with: docker stats
  # -------------------------------------------------------------------------
  # elasticsearch:
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 1G
  #         cpus: "2.0"
  # postgres:
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 512M

  # -------------------------------------------------------------------------
  # Turn Elasticsearch off entirely. Both apps degrade gracefully: Guest Score
  # falls back to in-process substring search, MarketMate to a linear scan.
  # Frees ~1 GB.
  #
  # `profiles` with an unused name is the documented way to disable a service
  # from an override file — there is no `enabled: false`.
  # -------------------------------------------------------------------------
  # elasticsearch:
  #   profiles: ["disabled"]
  # guest-score-api:
  #   environment:
  #     GS_ELASTIC_URL: ""
  #   depends_on: !override
  #     postgres: { condition: service_healthy }
  #     redis: { condition: service_healthy }
  #     mosquitto: { condition: service_healthy }

  # -------------------------------------------------------------------------
  # Bind the Postgres data directory to a host path so you can inspect or
  # snapshot it. Slower on macOS/Windows (the VirtioFS round-trip hurts
  # fsync-heavy workloads), which is why the default is a named volume.
  # -------------------------------------------------------------------------
  # postgres:
  #   volumes:
  #     - ./.local/pgdata:/var/lib/postgresql/data

  # -------------------------------------------------------------------------
  # Expose Postgres on a different host port when a Homebrew postgres already
  # owns 5432. Prefer setting POSTGRES_PORT in .env; this is the escape hatch
  # if you need something the variable does not cover.
  # -------------------------------------------------------------------------
  # postgres:
  #   ports:
  #     - "55432:5432"

  # -------------------------------------------------------------------------
  # Add Kibana for poking at the indices. Not in the main file: it is another
  # ~1 GB of JVM and most people never open it.
  # -------------------------------------------------------------------------
  # kibana:
  #   image: docker.elastic.co/kibana/kibana:8.15.3
  #   depends_on:
  #     elasticsearch:
  #       condition: service_healthy
  #   environment:
  #     ELASTICSEARCH_HOSTS: http://elasticsearch:9200
  #   ports:
  #     - "5601:5601"
  #   networks: [dev-stack]

# volumes:
#   gocache:
