# dev-stack environment.
#
#   cp .env.example .env
#
# Every variable here already has the same default baked into
# docker-compose.yml (`${FOO:-default}`), so an empty or missing .env produces
# a working stack. Copy it anyway — it is the file you edit when you want to
# change a port or turn a dependency off.
#
# GUIDING RULE FROM contract.md: every dependency is optional. Blank out
# GS_ELASTIC_URL and Guest Score falls back to in-process substring search;
# blank out GS_POSTGRES_DSN and it uses the JSON FileStore. That is the
# supported way to run a lighter stack, not a degraded mode.

# ---------------------------------------------------------------------------
# Sibling repositories (build contexts for the `apps` profile)
#
# contract.md names the directory market-mate. Some clones have it as
# marketmate. Point this at whatever yours is called rather than editing
# docker-compose.yml.
# ---------------------------------------------------------------------------
GUEST_SCORE_PATH=../guest-score
MARKET_MATE_PATH=../market-mate

# Dockerfile names within those contexts. The single-image Dockerfile at the
# repo root builds the API; the scoring service and the SPA need their own.
GUEST_SCORE_API_DOCKERFILE=Dockerfile
GUEST_SCORE_SCORING_DOCKERFILE=Dockerfile.scoring
GUEST_SCORE_WEB_DOCKERFILE=Dockerfile.web
MARKET_MATE_API_DOCKERFILE=Dockerfile
MARKET_MATE_WEB_DOCKERFILE=Dockerfile.web

# ---------------------------------------------------------------------------
# Host ports
#
# Change these if something already owns the port (a Homebrew postgres on 5432
# is the usual collision). The in-container ports never change — only the
# host side of the mapping — so no application config has to follow.
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTIC_PORT=9200
MQTT_PORT=1883
MQTT_WS_PORT=9001

GS_API_PORT=8090
GS_SCORING_PORT=9090
GS_WEB_PORT=5174
MM_API_PORT=8081
MM_WEB_PORT=5173

# ---------------------------------------------------------------------------
# PostgreSQL
#
# One server, two databases, created by postgres/init/01-databases.sh.
# NOTE: the init script only runs on an EMPTY data directory. Changing a
# password here after the first boot does nothing until you `make clean` or
# ALTER ROLE by hand — see docs/RUNBOOK.md.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

GS_DB_USER=guestscore
GS_DB_PASSWORD=guestscore
GS_DB_NAME=guestscore

MM_DB_USER=marketmate
MM_DB_PASSWORD=marketmate
MM_DB_NAME=marketmate

# ---------------------------------------------------------------------------
# Redis / Elasticsearch tuning
# ---------------------------------------------------------------------------
# Cache only, no persistence. Eviction policy is allkeys-lru.
REDIS_MAXMEMORY=256mb

# Xms must equal Xmx. Budget ~2x this for the container (Lucene is off-heap).
# Quoted: this file is also sourced by scripts/smoke.sh, and an unquoted space
# would make the shell run "-Xmx512m" as a command.
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# ---------------------------------------------------------------------------
# guest-score-api
#
# NOT configurable here, on purpose: GS_ADDR (:8090), GS_GRPC_ADDR (:9090) and
# MarketMate's PORT (8081). Those are the IN-CONTAINER listen addresses and are
# hardcoded in docker-compose.yml. Changing one would silently break the port
# mapping, the healthcheck and the in-cluster DNS name at the same time. Change
# the HOST side instead — GS_API_PORT and friends, above.
# ---------------------------------------------------------------------------
GS_LOG_LEVEL=info
# HMAC key for guest document hashes. Empty means the app uses a dev default
# and logs a warning. Set a fixed value if you want stable hashes across
# rebuilds; a real deployment must use a high-entropy key, and rotating it
# invalidates every previously issued guest_global_id.
GS_IDENTITY_KEY=
GS_SEED=true

# Unset to fall back to the JSON FileStore at GS_DATA_PATH.
GS_POSTGRES_DSN=postgres://guestscore:guestscore@postgres:5432/guestscore?sslmode=disable
GS_POSTGRES_MAX_CONNS=10
GS_DATA_PATH=./data/store.json
GS_MIGRATE=true

# Unset for a no-op cache (every read is a miss). DB 0 is Guest Score's.
GS_REDIS_ADDR=redis:6379
GS_REDIS_PASSWORD=
GS_REDIS_DB=0
GS_CACHE_TTL=60s

# Unset for in-process substring search.
GS_ELASTIC_URL=http://elasticsearch:9200
GS_ELASTIC_INDEX=guest-score-guests
GS_ELASTIC_USERNAME=
GS_ELASTIC_PASSWORD=

# Unset to disable event ingest entirely.
GS_MQTT_URL=tcp://mosquitto:1883
GS_MQTT_CLIENT_ID=guest-score-ingest
# + is a single-level wildcard: one segment, the property id.
GS_MQTT_TOPIC=guestscore/+/events
GS_MQTT_USERNAME=
GS_MQTT_PASSWORD=

# Unset to compute scores in-process instead of over gRPC.
GS_SCORING_GRPC=guest-score-scoring:9090
GS_GRAPHQL=true
# In-browser GraphQL explorer. Dev only.
GS_GRAPHIQL=true

# ---------------------------------------------------------------------------
# marketmate-api
# ---------------------------------------------------------------------------
# Unset for no durable transcript/extraction cache.
MM_POSTGRES_DSN=postgres://marketmate:marketmate@postgres:5432/marketmate?sslmode=disable
MM_MIGRATE=true

# Unset to use the existing in-memory go-cache. DB 1 is MarketMate's.
MM_REDIS_ADDR=redis:6379
MM_REDIS_DB=1

# Unset for a linear scan over cached recipes.
MM_ELASTIC_URL=http://elasticsearch:9200
MM_ELASTIC_INDEX=marketmate-recipes
MM_STORE_CACHE_TTL=15m

MM_GRAPHQL=true
MM_GRAPHIQL=true

# Fixture providers: no third-party API keys needed. Set to false only if you
# have filled in the keys below.
USE_FIXTURES=true
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Front-end build-time config
#
# Vite bakes VITE_* into the bundle at build time. The value below is used
# when the SPA container talks to the API over the compose network; if you run
# the SPA with `npm run dev` on the host instead, use http://localhost:8090.
# ---------------------------------------------------------------------------
GS_WEB_API_BASE_URL=http://guest-score-api:8090
MM_WEB_API_BASE_URL=http://marketmate-api:8081
